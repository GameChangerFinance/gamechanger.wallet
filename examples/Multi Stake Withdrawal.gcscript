{
  "type": "script",
  "title": "Multi Stake Withdrawal",
  "description": "Withdraws the staking rewards of the 3 reward addresses of the 'demos' workspace in one transaction. Run 'Multi Stake Delegation' first and wait for rewards. Each quantity must equal the whole reward balance at build time",
  "require": {
    "not": {
      "walletTypeIn": [
        "extension"
      ]
    }
  },
  "exportAs": "MultiWithdrawalDemo",
  "return": {
    "mode": "last"
  },
  "args": {
    "quantity-a": "1000000",
    "quantity-b": "1000000",
    "quantity-c": "1000000"
  },
  "run": {
    "argumentGuards": {
      "type": "macro",
      "run": "{assert(and(cmpBigNum('gt',get('args.quantity-a'),'0'),cmpBigNum('gt',get('args.quantity-b'),'0'),cmpBigNum('gt',get('args.quantity-c'),'0')),'quantities must be lovelace greater than 0')}"
    },
    "setWorkspace": {
      "type": "setCurrentWorkspace",
      "workspaceId": "demos"
    },
    "dependencies": {
      "type": "script",
      "run": {
        "addresses": {
          "type": "getAddresses",
          "keyPattern": "{artifactName}"
        }
      }
    },
    "txs": {
      "type": "script",
      "args": "{get('args')}",
      "run": {
        "buildWithdraw": {
          "type": "buildTx",
          "name": "WithdrawTx",
          "tx": {
            "withdrawals": {
              "A": {
                "address": "{get('cache.dependencies.addresses.RewardAddress-A.address')}",
                "quantity": "{get('args.quantity-a')}"
              },
              "B": {
                "address": "{get('cache.dependencies.addresses.RewardAddress-B.address')}",
                "quantity": "{get('args.quantity-b')}"
              },
              "C": {
                "address": "{get('cache.dependencies.addresses.RewardAddress-C.address')}",
                "quantity": "{get('args.quantity-c')}"
              }
            }
          }
        },
        "signWithdraw": {
          "type": "signTxs",
          "namePattern": "signed-{key}",
          "detailedPermissions": false,
          "txs": {
            "withdraw": "{get('cache.txs.buildWithdraw.txHex')}"
          }
        },
        "submitWithdraw": {
          "type": "submitTxs",
          "namePattern": "submitted-{key}",
          "txs": "{get('cache.txs.signWithdraw')}"
        }
      }
    },
    "finally": {
      "type": "script",
      "exportAs": "MultiWithdraw",
      "run": {
        "signWithdraw": {
          "type": "macro",
          "run": "{get('cache.txs.buildWithdraw.txHash')}"
        }
      }
    }
  }
}