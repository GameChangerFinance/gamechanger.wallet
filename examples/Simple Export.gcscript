{
  "type": "script",
  "title": "Simple Export",
  "description": "Exports the wallet name, the current address, the spending and staking public keys and three data constants under a single export named 'wallet'. Shows how exportAs returns the results of a script to the dapp",
  "exportAs": "wallet",
  "run": {
    "name": {
      "type": "getName"
    },
    "address": {
      "type": "getCurrentAddress"
    },
    "spendPubKey": {
      "type": "getSpendingPublicKey"
    },
    "stakePubKey": {
      "type": "getStakingPublicKey"
    },
    "extra1": {
      "type": "data",
      "value": "data of 0"
    },
    "extra2": {
      "type": "data",
      "value": "data of 1"
    },
    "extra3": {
      "type": "data",
      "value": "data of 2"
    }
  }
}